DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vayusetu?sslmode=require
# Optional direct, non-pooled URL used by Prisma migrations on Neon/Supabase.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/vayusetu?sslmode=require

# Comma-separated browser origins allowed to call the deployed API.
FRONTEND_ORIGINS=https://vayusetu-ten.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Shared /api/dashboard/live snapshot lifetime in seconds (minimum: 60).
DASHBOARD_CACHE_TTL_SECONDS=60

# SerpAPI Google Flights collector.
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_TIMEOUT_SECONDS=45
SERPAPI_MAX_RETRIES=3
SERPAPI_BACKOFF_SECONDS=1
SERPAPI_REQUEST_DELAY_SECONDS=1
VAYUSETU_AUTO_ETL=true
