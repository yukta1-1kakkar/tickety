{
  "manifest_version": 3,
  "name": "Tickety - Airfare Intelligence",
  "description": "Understand your flight fare before you book.",
  "version": "0.1.0",
  "minimum_chrome_version": "112",
  "icons": {"16":"icons/tickety-16.png","32":"icons/tickety-32.png","48":"icons/tickety-48.png","128":"icons/tickety-128.png"},
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://vayusetu-serpapi.onrender.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Tickety airfare intelligence", "default_popup": "popup/popup.html", "default_icon":{"16":"icons/tickety-16.png","32":"icons/tickety-32.png"}},
  "content_scripts": [{
    "matches": ["https://www.google.com/travel/flights*", "https://www.google.co.in/travel/flights*"],
    "js": ["config.js", "utils/context.js", "detectors/genericFlightDetector.js", "detectors/googleFlights.js", "detectors/detectorManager.js", "ui/mascot.js", "ui/insightExtras.js", "ui/ticketyWidget.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{"resources": ["ui/ticketyWidget.css"], "matches": ["https://*/*", "http://*/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
